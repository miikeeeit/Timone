# Timone — variabili d'ambiente (Fase 1, SOLO paper trading)
#
# Copia questo file in `.env` e compila i valori:
#     cp .env.example .env
#
# `.env` è in .gitignore: NON deve MAI finire nel repository.
#
# Le chiavi Alpaca vanno create nella dashboard Alpaca -> Paper Trading,
# SENZA permessi di prelievo (withdrawal). Timone non ne ha bisogno.

# Chiavi del conto PAPER Alpaca (non live). Lasciare vuoti qui: si compilano in .env
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Endpoint: bloccato di default sull'ambiente paper.
# Un endpoint diverso da quello paper viene RIFIUTATO dal codice.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Percorso del file di configurazione della Rotta (opzionale, default: ./rotta.yaml)
# TIMONE_ROTTA=./rotta.yaml

# Cartella dati/stato/log runtime (opzionale, default: ./data)
# TIMONE_DATA_DIR=./data
